# GitLab credentials for the gitlab-gastecnologia MCP server, loaded by its start command.
# Copied to ~/.config/kirocrew/gitlab-mcp.env (chmod 600) by `agents-team install`.
# Use the SERVICE ACCOUNT's personal access token, scope read_api (read-only is enough for agents-team).
# Never commit the filled file.
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.gastecnologia.com.br/api/v4
