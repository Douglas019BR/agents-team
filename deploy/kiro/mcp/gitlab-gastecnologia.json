{
  "command": "/bin/bash",
  "args": [
    "-c",
    "set -a && . \"$HOME/.config/kirocrew/gitlab-mcp.env\" && set +a && {node_setup}exec npx -y @zereight/mcp-gitlab"
  ],
  "env": {
    "GITLAB_READ_ONLY_MODE": "true",
    "USE_GITLAB_WIKI": "false",
    "USE_MILESTONE": "false",
    "USE_PIPELINE": "true"
  }
}
