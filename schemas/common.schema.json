{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agents-team.dev/v1/common.schema.json",
  "title": "agents-team: definições compartilhadas",
  "$defs": {
    "card_key": {
      "description": "Chave do cartão. Aceita chave do Jira (PROJ-123) ou slug gerado pelo orquestrador.",
      "type": "string",
      "pattern": "^([A-Z][A-Z0-9]+-[0-9]+|[a-z0-9][a-z0-9-]{2,63})$"
    },
    "role": {
      "type": "string",
      "enum": ["sdet", "dev", "reviewer", "qa", "sec", "teacher", "orchestrator"]
    },
    "agent_ref": {
      "type": "object",
      "required": ["name", "role", "model"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "role": { "$ref": "#/$defs/role" },
        "model": { "type": "string", "minLength": 1 },
        "version": { "description": "Versão da definição canônica do agente.", "type": "string" }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "request_changes", "block"]
    },
    "flow": {
      "type": "string",
      "enum": ["implement-system", "bdd-behave", "peer-review"]
    },
    "iso_datetime": { "type": "string", "format": "date-time" },
    "jira_action": {
      "description": "Ação no Jira declarada por um agente. Só o orquestrador aplica, após confirmação humana.",
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "comment" },
            "body": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "body"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "update_field" },
            "field": { "type": "string", "minLength": 1 },
            "set": {},
            "add": { "type": "array" },
            "remove": { "type": "array" }
          },
          "required": ["type", "field"],
          "minProperties": 3,
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "transition" },
            "to": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "to"],
          "additionalProperties": false
        }
      ]
    }
  }
}
