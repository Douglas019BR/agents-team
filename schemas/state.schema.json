{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agents-team.dev/v1/state.schema.json",
  "title": "agents-team: estado de um cartão (cards/<CARD>/state.json)",
  "description": "Escrito só pelo orquestrador. Agentes nunca editam este arquivo.",
  "type": "object",
  "required": ["schema", "card", "repo_id", "flow", "phase", "iteration", "max_iterations", "created_at", "updated_at", "history"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "agents-team/state@1" },
    "card": { "$ref": "common.schema.json#/$defs/card_key" },
    "repo_id": {
      "description": "Slug do remote (ex.: grupo-subgrupo-projeto).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "flow": { "$ref": "common.schema.json#/$defs/flow" },
    "phase": { "$ref": "#/$defs/phase" },
    "iteration": { "type": "integer", "minimum": 0, "maximum": 3 },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 },
    "worktree": { "type": "string" },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string" },
        "work": { "type": "string", "pattern": "^agents/[^/]+/work$" },
        "official": { "type": "string", "pattern": "^feature/.+$" }
      }
    },
    "merge_request": {
      "description": "Só no fluxo peer-review.",
      "type": "object",
      "required": ["project", "iid"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string" },
        "iid": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "head_sha": { "type": "string" }
      }
    },
    "verdicts": {
      "description": "Vereditos por iteração e por papel.",
      "type": "object",
      "patternProperties": {
        "^[0-9]{2}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer": { "$ref": "common.schema.json#/$defs/verdict" },
            "qa": { "$ref": "common.schema.json#/$defs/verdict" },
            "sec": { "$ref": "common.schema.json#/$defs/verdict" },
            "sdet": { "$ref": "common.schema.json#/$defs/verdict" }
          }
        }
      },
      "additionalProperties": false
    },
    "pending_jira_actions": {
      "description": "Lote consolidado aguardando confirmação humana.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "action"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "action": { "$ref": "common.schema.json#/$defs/jira_action" }
        }
      }
    },
    "escalation": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "enum": ["max_iterations", "agent_error", "ambiguous_card", "human_requested"] },
        "detail": { "type": "string" }
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "common.schema.json#/$defs/iso_datetime" },
    "history": {
      "description": "Log de transições, só de anexação.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "at": { "$ref": "common.schema.json#/$defs/iso_datetime" },
          "from": { "anyOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }] },
          "to": { "$ref": "#/$defs/phase" },
          "iteration": { "type": "integer", "minimum": 0 },
          "by": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "flow": { "const": "peer-review" } } },
      "then": { "required": ["merge_request"] },
      "else": { "required": ["branches"] }
    },
    {
      "if": { "properties": { "phase": { "const": "escalated" } } },
      "then": { "required": ["escalation"] }
    }
  ],
  "$defs": {
    "phase": {
      "description": "Fases da máquina de estados. As transições válidas ficam em workflows/<flow>.yml.",
      "type": "string",
      "enum": [
        "created",
        "discovery",
        "classify",
        "fetch_mr",
        "sdet",
        "dev",
        "review",
        "qa_sec",
        "consolidate",
        "draft_comments",
        "grouping_plan",
        "awaiting_human",
        "assemble",
        "final_gates",
        "jira_sync",
        "done",
        "escalated",
        "failed"
      ]
    }
  }
}
